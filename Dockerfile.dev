FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libstdc++6 \
    libqt6widgets6 \
    qt6-qpa-plugins \
    python3 \
    && rm -rf /var/lib/apt/lists/*

ENV QT_QPA_PLATFORM=offscreen

WORKDIR /workspace

COPY --chmod=0755 phantasmoon-gui /usr/local/bin/phantasmoon-gui